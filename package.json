{
    "name": "@solguardlabs/axiom-liquidity-protocol",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Managed-liquidity accounting and risk engine for multi-venue strategies.",
    "license": "MIT",
    "scripts": {
        "test": "node --test --experimental-strip-types \"tests/node/*.test.ts\"",
        "ci": "bash scripts/ci.sh",
        "typecheck": "tsc --noEmit",
        "fmt": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
        "fmt:check": "prettier --check .",
        "loc": "node scripts/check-loc.mjs",
        "demo": "node --experimental-strip-types src/cli.ts",
        "test:coverage": "node --experimental-test-coverage --test --experimental-strip-types \"tests/node/*.test.ts\""
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "bun@1.3.14",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "prettier": "^3.8.3",
        "typescript": "^7.0.2"
    }
}
